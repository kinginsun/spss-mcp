# SPSS MCP Server Configuration
# Copy this file to .env and fill in values as needed

# Path to IBM SPSS Statistics installation directory (or the stats binary).
# If not set, the server auto-detects via registry (Windows) or /Applications (macOS).
#
# Windows:
#   SPSS_INSTALL_PATH=C:\Program Files\IBM\SPSS Statistics\31
# macOS:
#   SPSS_INSTALL_PATH=/Applications/IBM SPSS Statistics 27
# SPSS_INSTALL_PATH=

# Directory for temporary intermediate files (runner .py and OMS text output)
# Defaults to %TEMP%\spss-mcp (Windows) or /tmp/spss-studio-mcp (macOS/Linux)
# SPSS_TEMP_DIR=

# Directory for persistent SPSS outputs (.spv viewer files and executed .sps syntax files)
# Defaults to <SPSS_TEMP_DIR>/results
# SPSS_RESULTS_DIR=

# Maximum seconds to wait for an SPSS analysis to complete
# SPSS_TIMEOUT=120

# Maximum seconds to wait for the persistent SPSS Python engine to start
# SPSS_STARTUP_TIMEOUT=300

# Set to 1 to force pyreadstat-only mode even if SPSS is installed
# SPSS_NO_SPSS=0
